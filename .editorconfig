root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,md,svg,xbm}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.{ps1,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 2
